# Токен бота от @BotFather (без него запускается демо-режим в браузере)
BOT_TOKEN=
# Публичный HTTPS-адрес, где открыт сервер (нужен Telegram для мини-приложения)
WEBAPP_URL=https://example.com
# Или только имя хоста: на своём сервере Caddy сам получит для него HTTPS-сертификат
# PUBLIC_HOST=77-233-213-93.sslip.io
# Ключ Claude API. Без него ИИ-кнопка подставляет вопросы из библиотеки
ANTHROPIC_API_KEY=
PORT=3000
